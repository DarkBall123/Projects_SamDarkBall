_RES_GEOMETRY = 1e13;
_RES_MEMORY = 1e15;
_RES_SHADOW = 10000;
_AXIS_HALF_LEN = 0.10;
_CAM_DIR_LEN = 0.25;
_MODEL_SCALE = 0.0833333;
_VISUAL_TEXTURE = "\sting\mat0_co.paa";
_VISUAL_MATERIAL = "\sting\sting.rvmat";

_deleteLevelsByResolution =
{
	private ["_p3d","_targetRes","_resolutions","_i"];

	_p3d = _this@0;
	_targetRes = _this@1;
	_resolutions = getResolutions _p3d;
	_i = (count _resolutions) - 1;

	while {_i >= 0} do
	{
		if ((_resolutions @ _i) == _targetRes) then
		{
			_p3d deleteLevel _i;
		};
		_i = _i - 1;
	};
};

_createAxisFromSelection =
{
	private ["_srcObj","_memObj","_selectionName","_axisName","_sel","_center","_p1","_p2","_i1","_i2","_axisSel"];

	_srcObj = _this@0;
	_memObj = _this@1;
	_selectionName = _this@2;
	_axisName = _this@3;

	_sel = _srcObj loadSelection _selectionName;
	if (isnil "_sel") then
	{
		echo ("Missing selection: " + _selectionName);
	}
	else
	{
		_center = centerOf _sel;
		_p1 = [_center @ 0, (_center @ 1) - _AXIS_HALF_LEN, _center @ 2];
		_p2 = [_center @ 0, (_center @ 1) + _AXIS_HALF_LEN, _center @ 2];

		_i1 = countPoints _memObj;
		_memObj addPoint _p1;

		_i2 = countPoints _memObj;
		_memObj addPoint _p2;

		_axisSel = newSelection _memObj;
		_axisSel selectPoints [_i1, _i2];
		_memObj save (_axisSel as _axisName);

		echo ("Created axis " + _axisName + " center: " + str _center);
	};
};

_getSelectionCenter =
{
	private ["_srcObj","_selectionName","_sel"];

	_srcObj = _this@0;
	_selectionName = _this@1;

	_sel = _srcObj loadSelection _selectionName;
	if (isnil "_sel") then
	{
		echo ("Missing selection: " + _selectionName);
		nil
	}
	else
	{
		centerOf _sel
	};
};

_createPointSelection =
{
	private ["_memObj","_point","_selectionName","_i","_sel"];

	_memObj = _this@0;
	_point = _this@1;
	_selectionName = _this@2;

	_i = countPoints _memObj;
	_memObj addPoint _point;

	_sel = newSelection _memObj;
	_sel selectPoints [_i];
	_memObj save (_sel as _selectionName);

	echo ("Created point " + _selectionName + ": " + str _point);
};

_scaleObject =
{
	private ["_obj","_scaleFactor","_op"];

	_obj = _this@0;
	_scaleFactor = _this@1;
	_op = "_vector = _this getPoint _x; _this setPoint [_x, _vector * " + str _scaleFactor + "];";
	_obj forEachPoint ["true", _op];
};

_applyVisualMaterial =
{
	private ["_obj","_op"];

	_obj = _this@0;
	_op = "_face = _this face _x; _face setTexture """ + _VISUAL_TEXTURE + """; _face setMaterial """ + _VISUAL_MATERIAL + """;";
	_obj forEachFace ["true", _op];
};

_sourcePath = this@0;
_result = "Script started";
console = openStandardIO;
_logPath = _sourcePath + ".o2log.txt";
deleteFile _logPath;
_logFile = openFile [_logPath, 2];

try
{
	_logFile << "Source: " << _sourcePath << eoln;
	_logFile << "Scale: " << str _MODEL_SCALE << eoln;
	_logFile << "Texture: " << _VISUAL_TEXTURE << eoln;
	_logFile << "Material: " << _VISUAL_MATERIAL << eoln;
	echo ("Source: " + _sourcePath);

	_p3d = newLODObject;
	if !(_p3d loadP3D _sourcePath) then
	{
		_result = "Failed to load P3D: " + _sourcePath;
		_logFile << _result << eoln;
		echo _result;
	}
	else
	{
		_result = "Loaded P3D";
		_logFile << _result << eoln;

		_baseObjects = getObjects _p3d;
		_base = _baseObjects @ 0;
		_logFile << "Level count: " << str (count _baseObjects) << eoln;

		[_p3d, _RES_MEMORY] call _deleteLevelsByResolution;
		[_p3d, _RES_GEOMETRY] call _deleteLevelsByResolution;
		[_p3d, _RES_SHADOW] call _deleteLevelsByResolution;
		_logFile << "Deleted old Memory/Geometry/ShadowVolume LODs" << eoln;

		_existingScale = _base getProperty "sting_scale_applied";
		_existingScaleValue = 1;
		if (_existingScale != "") then
		{
			_existingScaleValue = call compile _existingScale;
			if (_existingScaleValue <= 0) then
			{
				_existingScaleValue = 1;
			};
		};

		if (_existingScale != (str _MODEL_SCALE)) then
		{
			_rescaleFactor = _MODEL_SCALE / _existingScaleValue;
			[_base, _rescaleFactor] call _scaleObject;
			_base setProperty ["sting_scale_applied", _MODEL_SCALE];
			_logFile << "Applied model scale factor: " << str _rescaleFactor << eoln;
		}
		else
		{
			_logFile << "Model scale already applied, skipping rescale" << eoln;
		};

		[_base] call _applyVisualMaterial;
		_logFile << "Updated base visual LOD and rewrote face materials" << eoln;

		_geom = addLevel _p3d;
		_geom := _base;
		_p3d setResolution _RES_GEOMETRY;
		_geom setProperty ["autocenter", 0];
		_logFile << "Created Geometry LOD" << eoln;

		_mem = addLevel _p3d;
		_p3d setResolution _RES_MEMORY;
		_mem setProperty ["autocenter", 0];
		_logFile << "Created Memory LOD" << eoln;

		_bodyCenter = [_base, "body_0"] call _getSelectionCenter;
		_cameraCenter = [_base, "camera_0"] call _getSelectionCenter;
		if (isnil "_bodyCenter") then
		{
			_bodyCenter = [0,0,0];
		};

		[_base, _mem, "vint1_0", "vint1_axis"] call _createAxisFromSelection;
		[_base, _mem, "vint2_0", "vint2_axis"] call _createAxisFromSelection;
		[_base, _mem, "vint3_0", "vint3_axis"] call _createAxisFromSelection;
		[_base, _mem, "vint4_0", "vint4_axis"] call _createAxisFromSelection;
		_logFile << "Created rotor axes" << eoln;

		if !(isnil "_cameraCenter") then
		{
			[_mem, _cameraCenter, "pip_pilot_pos"] call _createPointSelection;

			_cameraDir = _cameraCenter - _bodyCenter;
			_cameraDirLen = [0,0,0] distance _cameraDir;
			if (_cameraDirLen < 0.001) then
			{
				_cameraDir = [0,1,0];
				_cameraDirLen = 1;
			};

			_cameraDirPoint = _cameraCenter + (_cameraDir * (_CAM_DIR_LEN / _cameraDirLen));
			[_mem, _cameraDirPoint, "pip_pilot_dir"] call _createPointSelection;
			_logFile << "Created camera points" << eoln;
		};

		[_mem, _bodyCenter, "TaskMarker_1_pos"] call _createPointSelection;
		_logFile << "Created task marker point" << eoln;

		if (save (_p3d as _sourcePath)) then
		{
			_result = "Saved: " + _sourcePath;
			_logFile << _result << eoln;
			echo _result;
		}
		else
		{
			_result = "Save failed: " + _sourcePath;
			_logFile << _result << eoln;
			echo _result;
		};
	};
}
catch
{
	_result = "Exception: " + str _exception;
	_logFile << _result << eoln;
	echo _result;
};

_result
